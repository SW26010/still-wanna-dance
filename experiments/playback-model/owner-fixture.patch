--- /dev/null
+++ b/internal/cacheproxy/issue51_lab_test.go
@@ -0,0 +1,252 @@
+package cacheproxy
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"log/slog"
+	"net"
+	"net/http"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"still-wanna-dance/internal/blocksched"
+)
+
+// Private research harness: production engine and scheduler, controlled local
+// media transport. Never compiled into the desktop product.
+func TestIssue51LabServer(t *testing.T) {
+	root, file := os.Getenv("LAB51_ROOT"), os.Getenv("LAB51_FILE")
+	if root == "" || file == "" {
+		t.Skip("explicit isolated lab inputs required")
+	}
+	data, err := os.ReadFile(file)
+	if err != nil {
+		t.Fatal(err)
+	}
+	body := string(data)
+	target := videoURL(body)
+	if err = os.MkdirAll(root, 0700); err != nil {
+		t.Fatal(err)
+	}
+	trace, err := os.Create(filepath.Join(root, "engine.jsonl"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer trace.Close()
+	log := slog.New(slog.NewJSONHandler(trace, &slog.HandlerOptions{Level: slog.LevelDebug}))
+	forceFresh := os.Getenv("LAB51_FORCE_FRESH") == "1"
+	singleHole := os.Getenv("LAB51_SINGLE_HOLE") == "1"
+	song := os.Getenv("LAB51_SONG")
+	if song == "" {
+		song = "4598"
+	}
+	songID, songErr := strconv.Atoi(song)
+	if songErr != nil || songID < 1 {
+		t.Fatal("invalid controlled song")
+	}
+	holeBlocks := 1
+	if value := os.Getenv("LAB51_HOLE_BLOCKS"); value != "" {
+		v, e := strconv.Atoi(value)
+		if e != nil || v < 1 || v > 8 {
+			t.Fatal("invalid hole count")
+		}
+		holeBlocks = v
+	}
+	warmBlocks := 2
+	if value := os.Getenv("LAB51_WARM_BLOCKS"); value != "" {
+		v, e := strconv.Atoi(value)
+		if e != nil || v < 1 || v > len(data)/int(DefaultBlockSize)-holeBlocks {
+			t.Fatal("invalid warm block count")
+		}
+		warmBlocks = v
+	}
+	var labSequence atomic.Int64
+	var slowGate *lab51RateGate
+	slowSeconds := 60
+	if value := os.Getenv("LAB51_SLOW_SECONDS"); value != "" {
+		v, e := strconv.Atoi(value)
+		if e != nil || v < 1 {
+			t.Fatal("invalid slow duration")
+		}
+		slowSeconds = v
+	}
+	if os.Getenv("LAB51_MODE") == "slow" {
+		slowGate = newLab51RateGate()
+		watchCtx, stopWatch := context.WithCancel(context.Background())
+		t.Cleanup(func() { stopWatch(); slowGate.restore() })
+		go func() {
+			tick := time.NewTicker(20 * time.Millisecond)
+			defer tick.Stop()
+			for {
+				select {
+				case <-watchCtx.Done():
+					return
+				case <-tick.C:
+				}
+				if _, e := os.Stat(filepath.Join(root, "slow-start")); e == nil {
+					break
+				}
+			}
+			slowGate.start(125000)
+			log.Info("lab_rate_started", "aggregate_bytes_per_second", 125000, "duration_seconds", slowSeconds)
+			timer := time.NewTimer(time.Duration(slowSeconds) * time.Second)
+			defer timer.Stop()
+			select {
+			case <-watchCtx.Done():
+				return
+			case <-timer.C:
+			}
+			slowGate.restore()
+			log.Info("lab_rate_restored")
+		}()
+	}
+	var once sync.Once
+	release := make(chan struct{})
+	delay := 66 * time.Second
+	if value := os.Getenv("LAB51_RELEASE_SECONDS"); value != "" {
+		v, e := strconv.Atoi(value)
+		if e != nil || v < 1 {
+			t.Fatal("invalid release delay")
+		}
+		delay = time.Duration(v) * time.Second
+	}
+	s, _ := setup(t, nil, func(cfg *Config) {
+		cfg.Logger = log
+		cfg.ObserveDownloadBytes = func(n int64) { log.Info("lab_upstream_bytes", "bytes", n) }
+		cfg.BeginResourceLoad = func() func() {
+			started := time.Now()
+			log.Info("lab_execution_acquired")
+			return func() { log.Info("lab_execution_released", "elapsed_ms", time.Since(started).Milliseconds()) }
+		}
+		cfg.DownloadConcurrencySoftLimit = 2
+		cfg.DownloadGrowInterval = 0
+		cfg.CacheUnlimited = true
+		cfg.ResolvePlayback = func(context.Context, string) (string, error) { return target, nil }
+		cfg.ResourceTransports = func(string) []http.RoundTripper {
+			return []http.RoundTripper{resourceTransportFunc(func(r *http.Request) (*http.Response, error) {
+				resp := fixtureRangeResponse(r, body)
+				var start, end int64
+				fmt.Sscanf(r.Header.Get("Range"), "bytes=%d-%d", &start, &end)
+				if slowGate != nil {
+					resp.Body = slowGate.reader(r.Context(), resp.Body, start)
+					return resp, nil
+				}
+				if start < int64(warmBlocks)*DefaultBlockSize || (singleHole && start >= int64(warmBlocks+holeBlocks)*DefaultBlockSize) {
+					return resp, nil
+				}
+				src := resp.Body
+				sent := int64(0)
+				resp.Body = io.NopCloser(publishReaderFunc(func(p []byte) (int, error) {
+					if sent >= 128*1024 {
+						select {
+						case <-release:
+						case <-r.Context().Done():
+							return 0, r.Context().Err()
+						}
+					}
+					if sent < 128*1024 && int64(len(p)) > 128*1024-sent {
+						p = p[:128*1024-sent]
+					}
+					n, e := src.Read(p)
+					sent += int64(n)
+					return n, e
+				}))
+				return resp, nil
+			})}
+		}
+	})
+	seedPreview(t, s, body)
+	for _, q := range []string{fmt.Sprintf("INSERT INTO songs(id) VALUES(%d) ON CONFLICT DO NOTHING", songID), fmt.Sprintf("INSERT INTO song_media(song_id,md5) SELECT %d,md5 FROM song_media WHERE song_id='1' ON CONFLICT(song_id) DO UPDATE SET md5=excluded.md5", songID)} {
+		if _, err = s.Store.db.Exec(q); err != nil {
+			t.Fatal(err)
+		}
+	}
+	lab51InitModel(t, s, root, int64(songID), videoKey(body), int64(len(data)), int64(warmBlocks)*DefaultBlockSize, release, log)
+	listener, err := net.Listen("tcp4", os.Getenv("LAB51_LISTEN"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	server := &http.Server{Handler: http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path != "/Api/Songs/play" || r.URL.Query().Get("id") != song {
+			http.NotFound(w, r)
+			return
+		}
+		labID := labSequence.Add(1)
+		wire := &lab51SupplyWriter{ResponseWriter: w}
+		w = wire
+		defer func() {
+			log.Info("lab_http_supply", "lab_id", labID, "status", wire.status, "bytes", wire.bytes, "first_successful_write", wire.firstSuccessfulWrite, "last_successful_write", wire.lastSuccessfulWrite, "write_failed", wire.writeFailed)
+		}()
+		log.Info("lab_client_request", "lab_id", labID, "method", r.Method, "range", r.Header.Get("Range"), "player", strings.HasPrefix(r.UserAgent(), "NSPlayer/"))
+		if r.Method == "GET" && strings.HasPrefix(r.UserAgent(), "NSPlayer/") {
+			once.Do(func() {
+				log.Info("lab_clock_started", "release_after_seconds", delay.Seconds())
+				if slowGate == nil {
+					go func() { time.Sleep(delay); close(release); log.Info("lab_upstream_released") }()
+				}
+			})
+		}
+		r = r.Clone(r.Context())
+		if forceFresh && r.Method == http.MethodGet {
+			log.Info("lab_cache_validation_ignored", "if_none_match_present", r.Header.Get("If-None-Match") != "", "if_modified_since_present", r.Header.Get("If-Modified-Since") != "")
+			r.Header.Del("If-None-Match")
+			r.Header.Del("If-Modified-Since")
+		}
+		r.Host = "api.udon.dance"
+		r.URL.Host = r.Host
+		r.URL.Scheme = "http"
+		if lab51BeforeDemand(w, r, wire) {
+			return
+		}
+		s.ServeHTTP(w, r)
+	})}
+	done := make(chan error, 1)
+	go func() { done <- server.Serve(listener) }()
+	ready := map[string]any{"address": listener.Addr().String(), "downloadGraceSeconds": blocksched.DownloadGrace.Seconds(), "releaseAfterFirstPlayerGETSeconds": delay.Seconds(), "blockSize": DefaultBlockSize, "bytes": len(data), "timeBasis": "explicit matching media duration inserted; experimental log model and2/10s handoff"}
+	ready["forceFreshResponses"] = forceFresh
+	ready["warmBlocks"] = warmBlocks
+	ready["singleHole"] = singleHole
+	ready["song"] = song
+	ready["holeBlocks"] = holeBlocks
+	ready["httpSupplyClock"] = true
+	if slowGate != nil {
+		ready["mode"] = "slow"
+		delete(ready, "releaseAfterFirstPlayerGETSeconds")
+		ready["aggregateBytesPerSecond"] = 125000
+		ready["slowSeconds"] = slowSeconds
+		ready["startTrigger"] = "slow-start file after actual OnVideoStart"
+	}
+	readyBytes, _ := json.Marshal(ready)
+	if err = os.WriteFile(filepath.Join(root, "ready.json"), readyBytes, 0600); err != nil {
+		t.Fatal(err)
+	}
+	ticker := time.NewTicker(200 * time.Millisecond)
+	defer ticker.Stop()
+	until := time.NewTimer(15 * time.Minute)
+	defer until.Stop()
+	for {
+		select {
+		case err := <-done:
+			if err != http.ErrServerClosed {
+				t.Fatal(err)
+			}
+			return
+		case <-ticker.C:
+			if _, e := os.Stat(filepath.Join(root, "stop")); e == nil {
+				server.Close()
+				return
+			}
+		case <-until.C:
+			server.Close()
+			t.Fatal("lab watchdog reached")
+		}
+	}
+}
diff --git a/internal/cacheproxy/issue51_model_test.go b/internal/cacheproxy/issue51_model_test.go
new file mode 100644
--- /dev/null
+++ b/internal/cacheproxy/issue51_model_test.go
@@ -0,0 +1,146 @@
+package cacheproxy
+
+import (
+	"context"
+	"log/slog"
+	"net/http"
+	"os"
+	model "still-wanna-dance/experiments/playback-model"
+	"still-wanna-dance/internal/vrclog"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+)
+
+// Private integration adapter: only the isolated test executable sees these hooks.
+var lab51Model *model.Model
+var lab51ModelEnabled bool
+var lab51Media model.Media
+var lab51HistoryMu sync.Mutex
+var lab51Previous *model.Transfer
+var lab51Missing int64
+var lab51Release <-chan struct{}
+var lab51ModelLog *slog.Logger
+
+func lab51InitModel(t *testing.T, s *Server, root string, songID int64, key string, size, missing int64, release <-chan struct{}, log *slog.Logger) {
+	seconds, err := strconv.ParseFloat(os.Getenv("LAB51_MEDIA_SECONDS"), 64)
+	if err != nil || seconds <= 0 || seconds >= 86400 {
+		t.Fatal("explicit matching media duration required")
+	}
+	margin, err := strconv.Atoi(os.Getenv("LAB51_MODEL_MARGIN_SECONDS"))
+	if err != nil || margin < 0 || margin > 60 {
+		t.Fatal("explicit model margin required")
+	}
+	enabled := os.Getenv("LAB51_MODEL_ENABLED") == "1"
+	lab51ModelEnabled = enabled
+	lab51Media = model.Media{SongID: songID, Key: key, Bytes: size, Seconds: seconds, Explicit: true}
+	lab51Model = model.New(model.Options{Enabled: enabled, AllowOwner: os.Getenv("LAB51_MODEL_ALLOW_OWNER") == "1", Margin: time.Duration(margin) * time.Second, MaxEventDelay: 4 * time.Second})
+	lab51Missing, lab51Release, lab51ModelLog = missing, release, log
+	if _, err = s.Store.db.Exec("UPDATE songs SET end=? WHERE id=?", seconds, songID); err != nil {
+		t.Fatal(err)
+	}
+	log.Info("lab_model_metadata", "seconds", seconds, "bytes", size, "model_enabled", enabled, "allow_owner", os.Getenv("LAB51_MODEL_ALLOW_OWNER") == "1", "margin_seconds", margin, "default_handoff_seconds", 2, "model_handoff_seconds", 10)
+	if !enabled {
+		return
+	}
+	dir := os.Getenv("LAB51_GAME_LOG_DIR")
+	if dir == "" {
+		t.Fatal("log directory required when model enabled")
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	t.Cleanup(cancel)
+	tail := &vrclog.Tail{Dir: dir, Playback: true}
+	poll := func() {
+		events, err := tail.Poll(time.Now())
+		if err != nil {
+			lab51Model.Observe(vrclog.Event{Reset: true}, time.Now())
+			return
+		}
+		for _, e := range events {
+			lab51Model.Observe(e, time.Now())
+		}
+	}
+	poll()
+	go func() {
+		tick := time.NewTicker(vrclog.PollInterval)
+		defer tick.Stop()
+		for {
+			select {
+			case <-ctx.Done():
+				return
+			case <-tick.C:
+				poll()
+			}
+		}
+	}()
+}
+
+func lab51BeforeDemand(w http.ResponseWriter, r *http.Request, wire *lab51SupplyWriter) bool {
+	if r.Method != "GET" || !strings.HasPrefix(r.UserAgent(), "NSPlayer/") {
+		return false
+	}
+	start, end := int64(0), lab51Media.Bytes
+	if h := r.Header.Get("Range"); h != "" {
+		if !strings.HasPrefix(h, "bytes=") || strings.Contains(h, ",") {
+			return false
+		}
+		a, b, ok := strings.Cut(strings.TrimPrefix(h, "bytes="), "-")
+		if !ok {
+			return false
+		}
+		var err error
+		start, err = strconv.ParseInt(a, 10, 64)
+		if err != nil {
+			return false
+		}
+		if b != "" {
+			n, err := strconv.ParseInt(b, 10, 64)
+			if err != nil {
+				return false
+			}
+			end = n + 1
+		}
+	}
+	ready := false
+	select {
+	case <-lab51Release:
+		ready = true
+	default:
+	}
+	lab51HistoryMu.Lock()
+	var previous *model.Transfer
+	if lab51Previous != nil {
+		p := *lab51Previous
+		previous = &p
+	}
+	lab51HistoryMu.Unlock()
+	d := lab51Model.Admit(time.Now(), lab51Media, previous, model.Request{SongID: lab51Media.SongID, Key: lab51Media.Key, Start: start, End: end, Missing: lab51Missing, BlockReady: ready})
+	lab51ModelLog.Info("lab_model_admission", "reject", d.Reject, "reason", d.Reason, "need_by", d.NeedBy, "range_start", start)
+	if d.Reject {
+		w.Header().Set("Cache-Control", "no-store")
+		http.Error(w, "Gateway Timeout", 504)
+		return true
+	}
+	p := &model.Transfer{SongID: lab51Media.SongID, Key: lab51Media.Key, Start: start, End: end, DeliveredThrough: start, Missing: lab51Missing}
+	lab51HistoryMu.Lock()
+	lab51Previous = p
+	lab51HistoryMu.Unlock()
+	wire.onWrite = func(n int, status int) {
+		if status != 200 && status != 206 {
+			return
+		}
+		lab51HistoryMu.Lock()
+		p.DeliveredThrough += int64(n)
+		lab51HistoryMu.Unlock()
+	}
+	return false
+}
+
+func lab51EndUse(s *Server, span useSpan, exit *sourceWithdrawal, clock playbackClock) {
+	for _, part := range lab51Model.Handoffs(exit.at, lab51Media, span.first, span.last, s.cfg.BlockSize) {
+		lab51ModelLog.Info("lab_model_handoff", "first", part.First, "last", part.Last, "seconds", part.Grace.Seconds())
+		s.endUseLocked(useSpan{span.key, part.First, part.Last}, exit.at, part.Grace, clock, sourceGET, exit.reason)
+	}
+}
diff --git a/internal/cacheproxy/issue51_rate_test.go b/internal/cacheproxy/issue51_rate_test.go
new file mode 100644
--- /dev/null
+++ b/internal/cacheproxy/issue51_rate_test.go
@@ -0,0 +1,141 @@
+package cacheproxy
+
+import (
+	"bytes"
+	"context"
+	"io"
+	"sync"
+	"testing"
+	"time"
+
+	"golang.org/x/time/rate"
+)
+
+// Private upstream body gate. Every transport in this engine shares one limiter.
+type lab51RateGate struct {
+	started chan struct{}
+	limiter *rate.Limiter
+	limited context.Context
+	restore context.CancelFunc
+}
+
+func newLab51RateGate() *lab51RateGate {
+	ctx, cancel := context.WithCancel(context.Background())
+	return &lab51RateGate{started: make(chan struct{}), limited: ctx, restore: cancel}
+}
+
+func (g *lab51RateGate) start(bytesPerSecond int) {
+	g.limiter = rate.NewLimiter(rate.Limit(bytesPerSecond), 16384)
+	g.limiter.AllowN(time.Now(), 16384) // no initial burst or accumulated idle credit
+	close(g.started)
+}
+
+func (g *lab51RateGate) reader(ctx context.Context, src io.ReadCloser, offset int64) io.ReadCloser {
+	return &lab51RateReader{gate: g, ctx: ctx, src: src, offset: offset}
+}
+
+type lab51RateReader struct {
+	gate   *lab51RateGate
+	ctx    context.Context
+	src    io.ReadCloser
+	offset int64
+}
+
+func (r *lab51RateReader) Close() error { return r.src.Close() }
+func (r *lab51RateReader) Read(p []byte) (int, error) {
+	g := r.gate
+	if err := r.ctx.Err(); err != nil {
+		return 0, err
+	}
+	select {
+	case <-g.started:
+	default:
+		if r.offset < 2*DefaultBlockSize {
+			if int64(len(p)) > 2*DefaultBlockSize-r.offset {
+				p = p[:2*DefaultBlockSize-r.offset]
+			}
+			n, e := r.src.Read(p)
+			r.offset += int64(n)
+			return n, e
+		}
+		select {
+		case <-g.started:
+		case <-r.ctx.Done():
+			return 0, r.ctx.Err()
+		case <-g.limited.Done():
+			return 0, context.Canceled
+		}
+	}
+	if g.limited.Err() == nil {
+		if len(p) > 16384 {
+			p = p[:16384]
+		}
+		waitCtx, cancel := context.WithCancel(r.ctx)
+		stop := context.AfterFunc(g.limited, cancel)
+		err := g.limiter.WaitN(waitCtx, len(p))
+		stop()
+		cancel()
+		if r.ctx.Err() != nil {
+			return 0, r.ctx.Err()
+		}
+		if err != nil && g.limited.Err() == nil {
+			return 0, err
+		}
+	}
+	n, e := r.src.Read(p)
+	r.offset += int64(n)
+	return n, e
+}
+
+func TestLab51SharedRateAndCancel(t *testing.T) {
+	g := newLab51RateGate()
+	defer g.restore()
+	g.start(128 * 1024)
+	payload := bytes.Repeat([]byte{73}, 64*1024)
+	start := time.Now()
+	var wg sync.WaitGroup
+	for range 2 {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			r := g.reader(context.Background(), io.NopCloser(bytes.NewReader(payload)), 2*DefaultBlockSize)
+			got, e := io.ReadAll(r)
+			if e != nil || !bytes.Equal(got, payload) {
+				t.Errorf("payload: %d bytes, %v", len(got), e)
+			}
+		}()
+	}
+	wg.Wait()
+	if elapsed := time.Since(start); elapsed < 950*time.Millisecond {
+		t.Fatalf("aggregate rate exceeded: %v", elapsed)
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if _, e := g.reader(ctx, io.NopCloser(bytes.NewReader(payload)), 0).Read(make([]byte, 1)); e != context.Canceled {
+		t.Fatalf("cancel: %v", e)
+	}
+	g.restore()
+	start = time.Now()
+	got, e := io.ReadAll(g.reader(context.Background(), io.NopCloser(bytes.NewReader(payload)), 2*DefaultBlockSize))
+	if e != nil || !bytes.Equal(got, payload) || time.Since(start) > time.Second {
+		t.Fatal("restore did not remove rate limit")
+	}
+}
+
+func TestLab51PrestartGate(t *testing.T) {
+	g := newLab51RateGate()
+	defer g.restore()
+	ctx, cancel := context.WithCancel(context.Background())
+	r := g.reader(ctx, io.NopCloser(bytes.NewReader([]byte{1})), 2*DefaultBlockSize)
+	done := make(chan error, 1)
+	go func() { _, e := r.Read(make([]byte, 1)); done <- e }()
+	select {
+	case <-done:
+		t.Fatal("body escaped prestart gate")
+	case <-time.After(30 * time.Millisecond):
+	}
+	cancel()
+	if e := <-done; e != context.Canceled {
+		t.Fatalf("cancel before start: %v", e)
+	}
+}
diff --git a/internal/cacheproxy/issue51_supply_test.go b/internal/cacheproxy/issue51_supply_test.go
new file mode 100644
--- /dev/null
+++ b/internal/cacheproxy/issue51_supply_test.go
@@ -0,0 +1,44 @@
+package cacheproxy
+
+import (
+	"net/http"
+	"time"
+)
+
+// Private measurement only. Unwrap preserves net/http ResponseController behavior.
+type lab51SupplyWriter struct {
+	http.ResponseWriter
+	status               int
+	bytes                int64
+	firstSuccessfulWrite time.Time
+	lastSuccessfulWrite  time.Time
+	writeFailed          bool
+	onWrite              func(int, int)
+}
+
+func (w *lab51SupplyWriter) Unwrap() http.ResponseWriter { return w.ResponseWriter }
+func (w *lab51SupplyWriter) WriteHeader(status int) {
+	w.status = status
+	w.ResponseWriter.WriteHeader(status)
+}
+func (w *lab51SupplyWriter) Write(p []byte) (int, error) {
+	if w.status == 0 {
+		w.status = http.StatusOK
+	}
+	n, err := w.ResponseWriter.Write(p)
+	w.bytes += int64(n)
+	if w.onWrite != nil && n > 0 {
+		w.onWrite(n, w.status)
+	}
+	if err == nil && n > 0 {
+		now := time.Now()
+		if w.firstSuccessfulWrite.IsZero() {
+			w.firstSuccessfulWrite = now
+		}
+		w.lastSuccessfulWrite = now
+	}
+	if err != nil {
+		w.writeFailed = true
+	}
+	return n, err
+}
