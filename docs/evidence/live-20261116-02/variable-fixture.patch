+package cacheproxy
+
+import (
+	"net/http"
+	"time"
+)
+
+// Private measurement only. Unwrap preserves net/http ResponseController behavior.
+type lab51SupplyWriter struct {
+	http.ResponseWriter
+	status               int
+	bytes                int64
+	firstSuccessfulWrite time.Time
+	lastSuccessfulWrite  time.Time
+	writeFailed          bool
+}
+
+func (w *lab51SupplyWriter) Unwrap() http.ResponseWriter { return w.ResponseWriter }
+func (w *lab51SupplyWriter) WriteHeader(status int) {
+	w.status = status
+	w.ResponseWriter.WriteHeader(status)
+}
+func (w *lab51SupplyWriter) Write(p []byte) (int, error) {
+	if w.status == 0 {
+		w.status = http.StatusOK
+	}
+	n, err := w.ResponseWriter.Write(p)
+	w.bytes += int64(n)
+	if err == nil && n > 0 {
+		now := time.Now()
+		if w.firstSuccessfulWrite.IsZero() {
+			w.firstSuccessfulWrite = now
+		}
+		w.lastSuccessfulWrite = now
+	}
+	if err != nil {
+		w.writeFailed = true
+	}
+	return n, err
+}
